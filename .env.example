# Copy these into Hostinger (Web App > Environment variables). For local use you can put them in a .env file.
PORT=3000
SITE_NAME=Your ACA Plans
SITE_SOURCE=youracaplans.com

# MySQL (create the database and user in hPanel > Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Admin portal at /admin
ADMIN_USER=
ADMIN_PASSWORD=
# Any long random string, for example from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
